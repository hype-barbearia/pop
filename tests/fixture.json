"passos": [
{
"t": "Primeiro contato (recepção): responder se identificando, perguntar preferência de barbeiro, colocar na agenda na hora."
},
{
"t": "Chegada (atendentes e barbeiros): sorriso e boas-vindas, barbeiros cedem o sofá, videogame encerrado se necessário."
},
{
"t": "Espera no Lounge (atendentes): oferecer todos os benefícios, servidos na bandeja, TV na ESPN."
},
{
"t": "Na cadeira (barbeiro): perguntar se aceita um benefício, diálogo amistoso, entender necessidades."
},
{
"t": "Fim do corte (barbeiro): direcionar ao lavatório após todo corte e acabamento."
},
{
"t": "Lavatório (atendentes): lavar o cabelo, oferecer o Head Spa a 100%, realizar se aceito."
},
{
"t": "Produtos e extras (barbeiro e recepção): indicar o serviço extra ou o produto HYPE Premium para a necessidade identificada."
},
{
"t": "Saída (recepção): fechar a comanda e despedida cordial.",
"crit": true
}
